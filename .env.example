# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA cometa o arquivo ".env" real em um repositório público.

# Caminho para o arquivo JSON da Service Account do Google
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# ID da planilha do Google Sheets (está na URL da planilha)
GOOGLE_SHEET_ID=

# Chave secreta do Flask (gere uma string aleatória longa)
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-segura

# Ambiente: development ou production
FLASK_ENV=development
